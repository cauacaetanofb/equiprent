# Copie para .env e defina uma senha local antes de iniciar.
# Formato simples: CHAVE=valor, sem aspas e sem comentarios no fim da linha.
# Nao use credenciais de producao. O Spring nao carrega este arquivo sozinho.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equiprent
DB_USERNAME=equiprent
DB_PASSWORD=
SERVER_PORT=8080
