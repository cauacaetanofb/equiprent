# Copie para .env e defina uma senha local antes de iniciar.
# Formato simples: CHAVE=valor, sem aspas e sem comentarios no fim da linha.
# Nao use credenciais de producao. O Spring nao carrega este arquivo sozinho.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equiprent
DB_USERNAME=equiprent
DB_PASSWORD=
SERVER_PORT=8080

# Opcional: habilite apenas para criar o primeiro administrador.
# Use uma senha exclusiva de 12 a 64 caracteres; remova-a depois do primeiro acesso.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
